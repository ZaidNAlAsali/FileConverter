<UserControl
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:project="clr-namespace:FileConverter.Properties"
        xmlns:conversionJobs="clr-namespace:FileConverter.ConversionJobs"
        x:Class="FileConverter.Controls.ConversionJobControl"
        mc:Ignorable="d"
        d:DesignHeight="118" d:DesignWidth="860">
    <d:DesignProperties.DataContext>
        <conversionJobs:ConversionJob />
    </d:DesignProperties.DataContext>

    <Border Background="{Binding State, Converter={StaticResource ConversionStateToBrush}, ConverterParameter=Background}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{Binding State, Converter={StaticResource ConversionStateToBrush}, ConverterParameter=Foreground}"
                    CornerRadius="11,0,0,11" />

            <Grid Grid.Column="1" Margin="18,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{Binding OutputFilePath}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OutputFilePath}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static project:Resources.ConvertedFrom}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11.5" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding InputFilePath}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputFilePath}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,4">
                    <TextBlock Text="{Binding UserState}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{Binding State, ConverterParameter=Foreground, Converter={StaticResource ConversionStateToBrush}}" />
                </Border>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}"
                           Foreground="{Binding State, ConverterParameter=Foreground, Converter={StaticResource ConversionStateToBrush}}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="{Binding State, ConverterParameter=Foreground, Converter={StaticResource ConversionStateToBrush}, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Margin="12,-4,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ConversionJobToEstimatedRemainingDuration}" Mode="OneWay">
                                <Binding Path="State" Mode="OneWay" />
                                <Binding Path="StartTime" Mode="OneWay" />
                                <Binding Path="Progress" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" Width="64" Margin="0,0,10,0">
                <Button Width="42" Height="42" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource SubtleButton}"
                        AutomationProperties.Name="{x:Static project:Resources.CancelJobTooltip}"
                        Visibility="{Binding State, ConverterParameter=|InProgress|Collapsed, Converter={StaticResource EnumEqualsToVisibility}}"
                        Command="{Binding CancelCommand}" ToolTip="{x:Static project:Resources.CancelJobTooltip}">
                    <TextBlock Text="×" FontSize="28" FontWeight="Light" Foreground="{DynamicResource ErrorForegroundBrush}" Margin="0,-4,0,0" />
                </Button>

                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding State, ConverterParameter=|Done|Collapsed, Converter={StaticResource EnumEqualsToVisibility}}">
                    <TextBlock Text="✓" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource DoneForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        Visibility="{Binding State, ConverterParameter=|Failed|Collapsed, Converter={StaticResource EnumEqualsToVisibility}}">
                    <TextBlock Text="!" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource FailedForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
