<Window x:Class="FileConverter.Views.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:project="clr-namespace:FileConverter.Properties"
        xmlns:local="clr-namespace:FileConverter"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{x:Static project:Resources.UpgradeWindowTitle}"
        WindowStartupLocation="CenterScreen"
        Icon="/FileConverter;component/Resources/ApplicationIcon.ico"
        MinHeight="460" MinWidth="560" Height="620" Width="620"
        Background="{DynamicResource CanvasBrush}"
        local:ApplicationThemeManager.EnableWindowTheme="True"
        DataContext="{Binding Upgrade, Source={StaticResource Locator}}">
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closing">
            <behaviors:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="14" Background="{DynamicResource InkPanelBrush}" Margin="0,0,14,0">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="A FRESHER BUILD IS READY" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{x:Static project:Resources.UpgradeAvailable}" Style="{StaticResource PageTitleText}"
                           FontSize="24" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
            <FlowDocumentScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      VerticalScrollBarVisibility="Auto"
                                      Document="{Binding UpgradeVersionDescription.ChangeLog, Source={StaticResource Upgrade}, Converter={StaticResource ChangelogToMarkdown}}" />
        </Border>

        <!-- Download button -->
        <Button Grid.Row="4" HorizontalContentAlignment="Stretch" Command="{Binding DownloadInstallerCommand}"
                Style="{StaticResource PrimaryButton}"
                Visibility="{Binding UpgradeVersionDescription.InstallerDownloadNotStarted, Source={StaticResource Upgrade}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="23" Foreground="White" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static project:Resources.DownloadAndInstallButtonTitle}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{x:Static project:Resources.DownloadAndInstallButtonDescription}" TextWrapping="Wrap" FontSize="11.5" Foreground="#DDEBFF" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
        </Button>

        <!-- Download in progress -->
        <Border Grid.Row="4" Style="{StaticResource SoftCardStyle}" Padding="16"
                Visibility="{Binding UpgradeVersionDescription.InstallerDownloadInProgress, Source={StaticResource Upgrade}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="23" Foreground="{DynamicResource AccentBrush}" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static project:Resources.UpgradeDownloadInProgress}" FontSize="14" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding UpgradeVersionDescription.InstallerDownloadProgress, Source={StaticResource Upgrade}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Install button -->
        <Button Grid.Row="4" HorizontalContentAlignment="Stretch" Command="{Binding LaunchInstallerCommand}"
                Style="{StaticResource PrimaryButton}"
                Visibility="{Binding UpgradeVersionDescription.InstallerDownloadDone, Source={StaticResource Upgrade}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="23" Foreground="White" Margin="0,0,13,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static project:Resources.InstallButtonTitle}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{x:Static project:Resources.InstallButtonDescription}" TextWrapping="Wrap" FontSize="11.5" Foreground="#DDEBFF" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
        </Button>
    </Grid>
</Window>
