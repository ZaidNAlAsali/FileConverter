<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileConverter"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:project="clr-namespace:FileConverter.Properties"
        xmlns:views="clr-namespace:FileConverter.Views"
        xmlns:viewModels="clr-namespace:FileConverter.ViewModels"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:generic="clr-namespace:FileConverter.ValueConverters.Generic"
        xmlns:controls="clr-namespace:FileConverter.Controls"
        x:Class="FileConverter.Views.SettingsWindow"
        MinWidth="900" MinHeight="640"
        Width="1180" Height="780"
        WindowStartupLocation="CenterScreen"
        Icon="/FileConverter;component/Resources/ApplicationIcon.ico"
        Background="{DynamicResource CanvasBrush}"
        local:ApplicationThemeManager.EnableWindowTheme="True"
        mc:Ignorable="d"
        DataContext="{Binding Settings, Source={StaticResource Locator}}">
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closing">
            <behaviors:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ConversionPresetTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <generic:IcoFileSizeSelectorConverter x:Key="IcoFileSizeSelector" />
            <generic:EqualsConverter x:Key="EqualsConverter" />

            <DataTemplate x:Key="NoPresetSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <Border Style="{StaticResource SoftCardStyle}" Margin="4" Padding="28">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                        <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="31"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Static project:Resources.NoPresetSelected}" Style="{StaticResource SectionTitleText}"
                                   FontSize="21" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="Choose a preset from the library to edit its output format, quality, file naming, and supported inputs."
                                   Style="{StaticResource BodySecondaryText}" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FolderSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <Border Style="{StaticResource CardStyle}" Margin="4" Padding="24" DataContext="{Binding SelectedFolder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,13,0">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="23"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static project:Resources.PresetFolder}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Organize related conversion recipes into a clear Explorer submenu."
                                           Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static project:Resources.PresetFolderName}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Loaded="SelectedFolderName_OnLoaded"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PresetSelectedTemplate" DataType="{x:Type viewModels:SettingsViewModel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource WarmAccentSoftBrush}" Margin="0,0,13,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="23"
                                               Foreground="{DynamicResource WarmAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Static project:Resources.Preset}" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource WarmAccentBrush}" />
                                    <TextBox Loaded="SelectedPresetName_OnLoaded" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"
                                             Text="{Binding SelectedPreset.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.65*" MinWidth="330" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="{x:Static project:Resources.OutputFormat}">
                                <StackPanel>
                                    <ComboBox MinHeight="40" ItemsSource="{Binding OutputTypes}"
                                              SelectedItem="{Binding SelectedPreset.Preset.OutputType, Converter={StaticResource OutputTypeEnumToViewModel}, Mode=TwoWay}">
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="6" Padding="9,6" Margin="2,4">
                                                            <TextBlock Foreground="{DynamicResource MainDarkBrush}" FontWeight="SemiBold"
                                                                       Text="{Binding Name, Converter={StaticResource ObjectToLocalizedString}}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:OutputTypeViewModel}">
                                                <TextBlock Text="{Binding Type}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ContentControl Content="{Binding SelectedPreset.Preset}"
                                                    Style="{StaticResource ConversionSettingsSelectorStyle}" Margin="0,14,0,0" />

                                    <Separator />

                                    <StackPanel>
                                        <TextBlock Text="{x:Static project:Resources.FileNameTemplate}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Margin="0,7,0,0" ToolTip="{x:Static project:Resources.OutputFilePathTemplateHelp}"
                                                 Text="{Binding SelectedPreset.OutputFileNameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Static project:Resources.InputExample}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static project:Resources.OutputFileNameTemplateSample}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Grid.Row="1" Text="{x:Static project:Resources.OutputExample}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FileNameConverter}">
                                                        <Binding Source="{x:Static project:Resources.OutputFileNameTemplateSample}" />
                                                        <Binding Path="SelectedPreset.Preset.OutputType" Mode="OneWay" />
                                                        <Binding Path="SelectedPreset.Preset.OutputFileNameTemplate" Mode="OneWay" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                                <Hyperlink CommandParameter="https://github.com/ZaidNAlAsali/ZFileConverter/blob/integration/docs/preset-reference.md#output-file-path-templates"
                                                           Command="{Binding OpenUrlCommand, Mode=OneWay}"><x:Static Member="project:Resources.Help" /></Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="{x:Static project:Resources.InputFormats}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="5" MaxHeight="350">
                                        <TreeView x:Name="InputTypesTreeView" ItemsSource="{Binding InputCategories}">
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type viewModels:InputExtensionCategory}" ItemsSource="{Binding InputExtensions}">
                                                    <CheckBox MinHeight="26" Margin="3" IsThreeState="True"
                                                              Content="{Binding Name, Converter={StaticResource ObjectToLocalizedString}}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                </HierarchicalDataTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:InputExtension}">
                                                    <CheckBox MinHeight="26" Margin="3" Content="{Binding Name}"
                                                              ToolTip="{Binding ToolTip}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ToolTip, Converter={StaticResource EqualsConverter}}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </TreeView.Resources>
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                    <Setter Property="IsExpanded" Value="True" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                        </TreeView>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{x:Static project:Resources.ActionWhenConversionSucceedTitle}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="{x:Static project:Resources.ActionWhenConversionSucceedDescription}" Margin="0,16,0,7" />
                                    <ComboBox Grid.Row="2" ItemsSource="{Binding InputPostConversionActions, Mode=OneTime}"
                                              SelectedItem="{Binding SelectedPreset.Preset.InputPostConversionAction, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding Converter={StaticResource ObjectToLocalizedString}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Margin="0,10,0,0">
                                        <Hyperlink CommandParameter="https://github.com/ZaidNAlAsali/ZFileConverter/blob/integration/docs/preset-reference.md#post-conversion-actions"
                                                   Command="{Binding OpenUrlCommand, Mode=OneWay}"><x:Static Member="project:Resources.Help" /></Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>

            <Style x:Key="SettingsSelectorStyle" TargetType="{x:Type ContentControl}">
                <Setter Property="ContentTemplate" Value="{StaticResource NoPresetSelectedTemplate}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedFolder, Converter={StaticResource EqualsConverter}}" Value="False">
                        <Setter Property="ContentTemplate" Value="{StaticResource FolderSelectedTemplate}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedPreset, Converter={StaticResource EqualsConverter}}" Value="False">
                        <Setter Property="ContentTemplate" Value="{StaticResource PresetSelectedTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Title>
        <Binding Converter="{StaticResource ApplicationVersionToApplicationName}" Mode="OneWay" Path="(local:Application.ApplicationVersion)" />
    </Window.Title>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource InkPanelBrush}" Margin="0,0,14,0">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="25" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="MAKE IT YOURS" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="ZFileConverter Settings" Style="{StaticResource PageTitleText}" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="Explorer-first presets" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2">
            <!-- Conversion presets -->
            <TabItem Header="{x:Static project:Resources.ConversionPresets}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid x:Name="PresetListGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,16,18,14">
                                <TextBlock Text="Preset library" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="This is what appears in Explorer." Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource BorderSoftBrush}" />

                            <TreeView Name="PresetTreeView" Grid.Row="2" Margin="8" AllowDrop="True"
                                      views:DragDropExtension.ScrollOnDragDrop="True"
                                      ItemsSource="{Binding PresetsRootFolder.Children}">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type viewModels:PresetFolderNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,2,0,2">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="17"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:PresetNode}">
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,2">
                                            <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource WarmAccentBrush}"
                                                    Margin="2,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError, FallbackValue=False}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource MainLighterColor}" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource MainDarkerColor}" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource DarkBackgroundColor}" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource LightForegroundColor}" />
                                        </Style.Resources>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeView_MouseDown" />
                                        <EventSetter Event="MouseUp" Handler="TreeView_MouseUp" />
                                        <EventSetter Event="DragOver" Handler="TreeView_DragOver" />
                                        <EventSetter Event="Drop" Handler="TreeView_Drop" />
                                        <EventSetter Event="MouseMove" Handler="TreeView_MouseMove" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <behaviors:Interaction.Behaviors>
                                    <views:TreeViewSelectionBehavior
                                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                        HierarchyPredicate="{Binding PresetsHierarchyPredicate}"
                                        ExpandSelected="False" />
                                </behaviors:Interaction.Behaviors>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static project:Resources.CreateANewFolder}" Command="{Binding CreateFolderCommand}" />
                                        <MenuItem Header="{x:Static project:Resources.AddNewPreset}" Command="{Binding AddNewPresetCommand}" />
                                        <MenuItem Header="{x:Static project:Resources.DuplicatePreset}" Command="{Binding DuplicatePresetCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static project:Resources.ImportPresets}" Command="{Binding ImportPresetCommand}" />
                                        <MenuItem Header="{x:Static project:Resources.ExportSelectedPresets}" Command="{Binding ExportPresetCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static project:Resources.RemoveSelectedPreset}" Command="{Binding RemoveSelectedPresetCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedPresetCommand}" />
                                </TreeView.InputBindings>
                            </TreeView>

                            <Border Grid.Row="3" Background="{DynamicResource BorderSoftBrush}" />
                            <StackPanel Grid.Row="4" Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding AddNewPresetCommand}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="{x:Static project:Resources.AddNewPreset}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,7,0" />
                                            <TextBlock Text="{x:Static project:Resources.AddNewPreset}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CreateFolderCommand}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="{x:Static project:Resources.CreateANewFolder}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F4;" Margin="0,0,7,0" />
                                            <TextBlock Text="{x:Static project:Resources.CreateANewFolder}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                                    <Button Command="{Binding DuplicatePresetCommand}" Style="{StaticResource SubtleButton}" Padding="9"
                                            AutomationProperties.Name="{x:Static project:Resources.DuplicatePreset}"
                                            ToolTip="{x:Static project:Resources.DuplicatePreset}">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="16" />
                                    </Button>
                                    <Button Command="{Binding ImportPresetCommand}" Style="{StaticResource SubtleButton}" Padding="9"
                                            AutomationProperties.Name="{x:Static project:Resources.ImportPresets}"
                                            ToolTip="{x:Static project:Resources.ImportPresets}">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B5;" FontSize="16" />
                                    </Button>
                                    <Button Command="{Binding ExportPresetCommand}" Style="{StaticResource SubtleButton}" Padding="9"
                                            AutomationProperties.Name="{x:Static project:Resources.ExportSelectedPresets}"
                                            ToolTip="{x:Static project:Resources.ExportSelectedPresets}">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="16" />
                                    </Button>
                                    <Button Command="{Binding RemoveSelectedPresetCommand}" Style="{StaticResource SubtleButton}" Padding="9"
                                            AutomationProperties.Name="{x:Static project:Resources.RemoveSelectedPreset}"
                                            ToolTip="{x:Static project:Resources.RemoveSelectedPreset}">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="16" Foreground="{DynamicResource ErrorForegroundBrush}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Column="2" Content="{Binding .}" Style="{StaticResource SettingsSelectorStyle}" />
                </Grid>
            </TabItem>

            <!-- Application settings -->
            <TabItem Header="{x:Static project:Resources.Application}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,2,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.ColumnSpan="3" Header="Appearance">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Choose the atmosphere that feels right" Style="{StaticResource SectionTitleText}" FontSize="15" />
                                    <TextBlock Text="Dark is the default. You can switch instantly without restarting ZFileConverter."
                                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                                    <RadioButton GroupName="AppearanceTheme" Style="{StaticResource ChoiceCardRadioButton}"
                                                 AutomationProperties.Name="Use dark appearance"
                                                 IsChecked="{Binding Settings.AppearanceTheme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static local:ApplicationTheme.Dark}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE708;" FontSize="17" Margin="0,0,8,0" />
                                            <TextBlock Text="Dark" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="AppearanceTheme" Style="{StaticResource ChoiceCardRadioButton}" Margin="9,0,0,0"
                                                 AutomationProperties.Name="Use light appearance"
                                                 IsChecked="{Binding Settings.AppearanceTheme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static local:ApplicationTheme.Light}, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE706;" FontSize="17" Margin="0,0,8,0" />
                                            <TextBlock Text="Light" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="General">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static project:Resources.Language}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SupportedCultures, Mode=OneTime}"
                                          SelectedValue="{Binding Settings.ApplicationLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Converter={StaticResource CultureInfoToString}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="{x:Static project:Resources.MaximumNumberOfSimultaneousConversions}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,16,14,0" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <Slider Minimum="1" Maximum="16" SmallChange="1" TickPlacement="BottomRight"
                                            Value="{Binding Settings.MaximumNumberOfSimultaneousConversions, Mode=TwoWay}" AutoToolTipPlacement="TopLeft" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{x:Static project:Resources.HardwareAccelerationMode}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,16,14,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding HardwareAccelerationModes, Mode=OneTime}"
                                          SelectedValue="{Binding Settings.HardwareAccelerationMode, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Converter={StaticResource HardwareAccelerationModeToString}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Grid.Column="2" Header="Completion workflow">
                            <StackPanel>
                                <CheckBox x:Name="QuitAtEndCheckBox" Content="{x:Static project:Resources.AutomaticallyExitWhenAllConversionsFinished}"
                                          IsChecked="{Binding Settings.ExitApplicationWhenConversionsFinished, Mode=TwoWay}" />
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Padding="12" Margin="0,12,0,0"
                                        Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Collapsed, ElementName=QuitAtEndCheckBox}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static project:Resources.ExitWaitingDuration}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Slider x:Name="DurationBeforeQuitSlider" Margin="0,8,0,0"
                                                    Value="{Binding Settings.DurationBetweenEndOfConversionsAndApplicationExit, Mode=TwoWay}"
                                                    Minimum="0" Maximum="10" SmallChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.1" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Value, Converter={StaticResource DoubleToTimeString}, ElementName=DurationBeforeQuitSlider}"
                                                       Foreground="{DynamicResource MainDarkBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <CheckBox Margin="0,16,0,0" Content="{x:Static project:Resources.CopyFilesInClipboardAfterConversion}"
                                          IsChecked="{Binding Settings.CopyFilesInClipboardAfterConversion, Mode=TwoWay}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="4" Grid.ColumnSpan="3" Header="Updates and maintenance">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keep ZFileConverter current" Style="{StaticResource SectionTitleText}" FontSize="15" />
                                    <TextBlock Text="Check for improvements automatically when the converter starts."
                                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Settings.CheckUpgradeAtStartup, Mode=TwoWay}"
                                          Content="{x:Static project:Resources.AutomaticallyCheckForUpdates}" VerticalAlignment="Center" Margin="22,0,0,0" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem Header="{x:Static project:Resources.About}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource InkCardStyle}" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Border Width="82" Height="82" CornerRadius="24" Background="White" HorizontalAlignment="Left">
                                    <Image Width="56" Height="56" Source="/FileConverter;component/Resources/ApplicationIcon.ico" />
                                </Border>
                                <TextBlock Margin="0,24,0,0" Foreground="White" FontFamily="Segoe UI Variable Display"
                                           FontSize="29" FontWeight="SemiBold" Text="ZFileConverter" />
                                <TextBlock Foreground="#AFC4DF" FontSize="14" Margin="0,5,0,0">
                                    <TextBlock.Text>
                                        <Binding Path="(local:Application.ApplicationVersion)" Converter="{StaticResource ApplicationVersionToApplicationName}" Mode="OneWay" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="The right-click file converter, kept useful and dependable for modern Windows."
                                           Foreground="#D8E5F4" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,20,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button Command="{Binding OpenUrlCommand, Mode=OneWay}"
                                        CommandParameter="https://github.com/ZaidNAlAsali/ZFileConverter"
                                        Background="{DynamicResource InkPanelSoftBrush}" BorderBrush="#36506F" Foreground="White"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" FontSize="17" Margin="0,0,9,0" />
                                        <TextBlock Text="View project on GitHub" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Copyright © 2026 Adrien Allard. GPL v3." Foreground="#8399B5" FontSize="10.5" Margin="2,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="2,0,0,14">
                                <TextBlock Text="What changed" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Release notes and project history." Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource BorderSoftBrush}" />
                            <FlowDocumentScrollViewer Grid.Row="2" Margin="0,10,0,10"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                      Document="{Binding UpgradeVersionDescription.ChangeLog, Source={StaticResource Upgrade}, Converter={StaticResource ChangelogToMarkdown}, ConverterParameter=True|}" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Visibility="{Binding DisplaySeeChangeLogLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Hyperlink Command="{Binding GetChangeLogContentCommand, Mode=OneWay}"><x:Static Member="project:Resources.SeeChangeLog" /></Hyperlink>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,7,0" Style="{StaticResource SubtleButton}" Padding="11,8"
                                            ToolTip="{x:Static project:Resources.IssueButtonDescription}"
                                            AutomationProperties.Name="Open project issues"
                                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                                            CommandParameter="https://github.com/ZaidNAlAsali/ZFileConverter/issues">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE730;" FontSize="16" Margin="0,0,7,0" />
                                            <TextBlock Text="Issues" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SubtleButton}" Padding="11,8"
                                            ToolTip="{x:Static project:Resources.DocumentationButtonDescription}"
                                            AutomationProperties.Name="Open documentation"
                                            Command="{Binding OpenUrlCommand, Mode=OneWay}"
                                            CommandParameter="https://github.com/ZaidNAlAsali/ZFileConverter#readme">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="16" Margin="0,0,7,0" />
                                            <TextBlock Text="Docs" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Save applies changes to Explorer and keeps this window open."
                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{x:Static project:Resources.Close}" MinWidth="100"
                    Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" />
            <Button Grid.Column="3" Content="{x:Static project:Resources.Save}" MinWidth="120" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
